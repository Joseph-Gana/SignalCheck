GEMINI_API_KEY=your_gemini_api_key_here
# Optional server port. Defaults to 3001 locally.
PORT=3001
# Optional comma-separated allowlist for a separately hosted frontend.
# Leave empty for the recommended same-origin deployment.
CORS_ORIGIN=
# Optional public API base URL for a separately hosted frontend.
# Leave empty for same-origin production deployment.
VITE_API_BASE_URL=
# Optional demo-friendly API rate-limit overrides. Defaults: 30 requests / 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
